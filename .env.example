# fvault environment variables (all optional).
# Load these in your shell service or systemd unit, not in the vault data folder.

# Data directory. Default: ./data (relative to the working directory).
FVAULT_HOME=/var/lib/fvault

# Web bind address. Default: 127.0.0.1
FVAULT_HOST=127.0.0.1

# auto scans 8000-8099 then falls back to an OS-assigned port.
# Use a fixed number behind a reverse proxy, e.g. 17384.
FVAULT_PORT=17384

# Mark the session cookie Secure. Enable behind HTTPS.
FVAULT_COOKIE_SECURE=true

# Trust X-Forwarded-For from a reverse proxy (nginx, Caddy, Traefik).
FVAULT_TRUST_PROXY=true

# Web session lifetime in minutes. Default: 30.
FVAULT_SESSION_TTL_MINUTES=30

# Failed login attempts before the IP is locked. Default: 3.
FVAULT_MAX_ATTEMPTS=10

# Lockout duration in minutes. Default: 15.
FVAULT_LOCKOUT_MINUTES=15

# How long the CLI keeps a copied value on the clipboard. Default: 30 seconds.
FVAULT_CLIPBOARD_CLEAR_SECONDS=30

# Optional overrides for template/static locations (default: ./templates, ./static).
# FVAULT_TEMPLATES=/opt/fvault/templates
# FVAULT_STATIC=/opt/fvault/static
